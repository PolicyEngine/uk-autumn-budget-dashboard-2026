    {"name": "launch rules as a list", "ops": [{"op": "set", "path": ["meta", "launch_rules"], "to": ["Each forecast starts at its launch."]}], "accepted": false},
    {"name": "a launch rule for no frequency drawn", "ops": [{"op": "set", "path": ["meta", "launch_rules", "monthly"], "to": "From the month."}], "accepted": true},
    {"name": "parliament ends where it starts", "ops": [{"op": "set", "path": ["meta", "parliament", "end", "calendar"], "to": 2024}], "accepted": false},
