    "carers_allowance_earnings_taper": {
      "description": "In England and Wales, Carer's Allowance no longer stops when weekly net earnings pass the Weekly Earnings Limit, 16 hours at the National Living Wage (£212 a week at April 2027's £13.21, rounded up to the pound): it is reduced by £1 for each £1 of earnings above the limit, a 100% taper, to nothing once earnings exceed the limit by the full weekly rate. The native model uses a provisional start of 6 October 2030 until DWP confirms the date within 2030-31. Carers at or below the limit and Scotland's Carer Support Payment are unchanged. The native model applies the couple election, overlapping-benefit rules, income tax and Universal Credit interactions; take-up follows the data.",
      "display": "schedule",
      "rows": [
        {
          "label": "Earnings taper in force",
          "unit": "percent",
          "unit_words": null,
          "primary": true,
          "points": [
            {
              "key": "2026-04-06",
              "label": "6 April 2026",
              "year": 2026,
              "before": 0.0,
              "after": 0.0
            },
            {
              "key": "2030-10-06",
              "label": "6 October 2030",
              "year": 2030,
              "before": 0.0,
              "after": 1.0
            }
          ],
          "source": {
            "before": {
              "kind": "pre_budget_parameter",
              "where": "budget_policy.json measures.carers_allowance_earnings_taper.paths.gov.dwp.carers_allowance.earnings_taper.applies",
              "path": "gov.dwp.carers_allowance.earnings_taper.applies",
              "model_commit": "da31e8698f77b9a205c899e0755e5f268ebbe58a",
              "references": [
                "https://www.gov.uk/government/publications/budget-2026-document/budget-2026-html"
              ]
            },
            "after": {
              "kind": "engine_parameter",
              "where": "policyengine-uk 2.174.1 gov.dwp.carers_allowance.earnings_taper.applies, on statutory dates before fiscal-year conversion",
              "path": "gov.dwp.carers_allowance.earnings_taper.applies",
              "model_commit": "aa2713ecab059d674a7b5045797a2f6349add540",
              "parameter_unit": "/1"
            }
          },
          "note": "Native start 6 October 2030 is the model assumption until DWP confirms the date."
        }
      ]
    },
    "household_energy_payment_2026": {
      "description": "A one-off £100 payment from January 2027 to each household in England in property valuation bands A to D (the lowest four of England's eight), up to 20 million households, paid into bank accounts and counted as household income in 2026-27. Scotland, Wales and Northern Ireland receive a share of the funding instead, which is not modelled.",
