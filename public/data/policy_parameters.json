            }
          ],
          "source": {
            "before": {
              "kind": "engine_parameter",
              "where": "the earnings limit (gov.dwp.carers_allowance.earnings_limit); with the measure, 16 hours at the National Living Wage (moved on with gov.economic_assumptions.indices.obr.average_earnings) plus the weekly rate (gov.dwp.carers_allowance.rate) divided by the taper rate"
            },
            "after": {
              "kind": "modifier_constant",
              "where": "budget_measures/carers_allowance_earnings_taper.py carers_allowance_earnings_taper(start_year, taper_rate, limit_hours, national_living_wage_2027)"
            }
          },
          "note": "Current law stops the allowance at £1 over the earnings limit (£204 a week, not uprated in the engine); with the measure it falls by £1 for each £1 above the limit"
        }
      ]
    },
