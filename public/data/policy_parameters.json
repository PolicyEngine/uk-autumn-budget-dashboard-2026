          ],
          "source": {
            "before": {
              "kind": "engine_parameter",
              "where": "the earnings limit (gov.dwp.carers_allowance.earnings_limit); with the measure, the limit plus the weekly rate (gov.dwp.carers_allowance.rate) divided by the taper rate"
            },
            "after": {
              "kind": "modifier_constant",
              "where": "budget_measures/carers_allowance_earnings_taper.py carers_allowance_earnings_taper(start_year, taper_rate)"
