# API URL for frontend (Vite)
VITE_API_URL=http://localhost:5001/api/personal-impact

# Lifecycle calculator API (Personal impact tab). The service URL followed by
# /api/lifecycle, with no trailing slash: the page POSTs to <this>/calculate.
# Baked in at build time; a Vercel production build fails without it.
# Production: https://uk-budget-api-2026-qevs5bboca-ew.a.run.app/api/lifecycle
# Local (docker compose maps the API to port 5001):
NEXT_PUBLIC_LIFECYCLE_API_URL=http://localhost:5001/api/lifecycle

# Single-year household API (Personal impact tab, Single-year effect). The
# service URL followed by /api/household-impact, with no trailing slash: the
# page POSTs to this URL itself. Baked in at build time; a Vercel production
# build fails without it, as for the lifecycle URL. The fetch lives in
# src/utils/householdImpactApi.js.
# Production: https://uk-budget-api-2026-qevs5bboca-ew.a.run.app/api/household-impact
# Local (HOUSEHOLD_WORKERS=2 PORT=8010 uv run uk-budget-api):
NEXT_PUBLIC_HOUSEHOLD_API_URL=http://localhost:8010/api/household-impact

# Multizone base path (defaults to /uk/autumn-budget-2026)
# NEXT_PUBLIC_BASE_PATH=

# PolicyEngine data access (private HF dataset repo)
HUGGING_FACE_TOKEN=
